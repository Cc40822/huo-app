.container { min-height: 100vh; background: #f5f5f5; }
.topbar { height: 56px; background: #fff; border-bottom: 1px solid #eee; display: flex; align-items: center; justify-content: center; }
.topbar-title { font-size: 18px; font-weight: 600; }
.profile-header { background: #fff; padding: 24px 16px 20px; text-align: center; border-bottom: 1px solid #eee; }
.profile-avatar { width: 72px; height: 72px; border-radius: 50%; background: linear-gradient(135deg, #FF6B35, #FFB085); display: flex; align-items: center; justify-content: center; font-size: 36px; margin: 0 auto 12px; }
.profile-name { font-size: 18px; font-weight: 600; display: block; }
.profile-desc { font-size: 13px; color: #888; display: block; margin-top: 4px; }
.profile-stats { display: flex; justify-content: center; gap: 32px; margin-top: 16px; }
.stat-item { text-align: center; }
.stat-num { display: block; font-size: 18px; font-weight: 700; }
.stat-label { display: block; font-size: 11px; color: #888; margin-top: 2px; }
.menu-group { background: #fff; margin-top: 12px; }
.menu-item { display: flex; align-items: center; padding: 14px 16px; border-bottom: 1px solid #f0f0f0; }
.menu-item:last-child { border-bottom: none; }
.menu-icon { width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 18px; margin-right: 12px; }
.menu-text { font-size: 15px; flex: 1; }
.menu-arrow { color: #888; font-size: 14px; }